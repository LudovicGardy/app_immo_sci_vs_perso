# The Dockerfile does COPY . . : without this file, everything lying in the app folder
# (.env, .git, local .venv, caches) would enter the image and be sent as build context.

.git
.github
.gitignore
.dockerignore

# Secrets. The local run gets .env through env_file in compose.yaml (the config code reads
# the process environment when it finds no .env file).
.env
.env.*

# Python, venv, caches
.venv/
**/__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage*
coverage.xml
junit.xml

# Archives, notebooks, logs and local launch scripts, not needed at runtime
_ignore_archives/
_ignore_documents/
_ignore_notebooks/
logs/
*.ipynb
start-app.sh
stop-app.sh

.DS_Store
